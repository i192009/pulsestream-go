# Development credentials only. Replace before exposing the stack.
PULSE_KEYS=demo-key:tenant-demo:admin,reader-key:tenant-demo:reader
PULSE_DATABASE_URL=postgres://pulse:pulse-dev@postgres:5432/pulse?sslmode=disable
PULSE_BROKERS=redpanda:9092
PULSE_CLICKHOUSE=http://clickhouse:8123
PULSE_CLICKHOUSE_PASSWORD=pulse-dev
PULSE_REDIS=redis:6379
PULSE_ORIGIN=http://localhost:13000
PULSE_PARTITIONS=8
PULSE_RATE=10000
PULSE_MAX_BATCH=500
PULSE_POLL=1000
PULSE_LATENESS=2m
PULSE_OUT_OF_ORDER=10s
PULSE_GROUP=pulsestream-v1
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318

# Optional overrides: tenant ID to fixed-window events/second quota.
PULSE_TENANT_RATES=tenant-demo:10000
