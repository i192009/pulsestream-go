{
  "uid": "pulse",
  "title": "PulseStream",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "pulsestream"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Broker acknowledgements / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(pulse_events_total{stage=\"ingest\",result=\"acked\"}[1m]))",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Durably processed / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(pulse_events_total{stage=\"process\",result=\"committed\"}[1m]))",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Operation p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,operation)(rate(pulse_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue & worker utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "pulse_resources",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Retries & overload / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(stage,result)(rate(pulse_events_total{result=~\"retry|backpressure|quota\"}[1m]))",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Resident memory",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU seconds / sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Go goroutines",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DLQ & alerts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(stage,result)(pulse_events_total{stage=~\"dlq|alert\"})",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redpanda consumer lag",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pulse-prometheus"
      },
      "targets": [
        {
          "expr": "pulse_resources{resource=\"consumer_lag\"}",
          "legendFormat": "{{operation}} {{stage}} {{resource}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}